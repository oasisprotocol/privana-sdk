{
  "name": "@oasisprotocol/privana-sdk",
  "version": "0.3.0",
  "description": "React SDK for Privana - manage deposits, withdrawals, locks, and transfers",
  "author": "Oasis Protocol Foundation <security@oasisprotocol.org>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/oasisprotocol/privana-sdk#readme",
  "bugs": {
    "url": "https://github.com/oasisprotocol/privana-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oasisprotocol/privana-sdk.git",
    "directory": "sdk/js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./on-ramp": {
      "import": {
        "types": "./dist/on-ramp.d.ts",
        "default": "./dist/on-ramp.js"
      },
      "require": {
        "types": "./dist/on-ramp.d.cts",
        "default": "./dist/on-ramp.cjs"
      }
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "bun run build:css && tsup",
    "build:css": "bunx @tailwindcss/cli -i src/globals.css -o src/compiled.css --minify && bun run scripts/scope-css.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@moonpay/moonpay-react": "^1.10.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "viem": ">=2.0.0",
    "wagmi": ">=2.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "viem": "^2.44.4",
    "wagmi": "^3.4.1",
    "@tanstack/react-query": "^5.90.19"
  }
}
